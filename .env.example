# Required
PL_API_KEY=your-projectionlab-api-key-here

# The server listens on a localhost WebSocket for the browser extension (or
# bootstrap snippet) to connect.
# PL_WS_PORT=8788
# PL_WS_TOKEN=                # auto-generated at ~/.projectionlab-mcp/ws-token if unset

# Optional (defaults shown)
# PL_APP_URL=https://app.projectionlab.com
# PL_API_READY_TIMEOUT_MS=30000
# PL_EXPORT_CACHE_MS=90000
# PL_PRETTY_JSON=false        # pretty-print JSON output (uses ~25-40% more tokens)
# PL_SNAPSHOT_DIR=~/.projectionlab-mcp/snapshots
# LOG_LEVEL=info

# Start read-only; set to false when you want write/mutation tools enabled.
PL_READ_ONLY=true
