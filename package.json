{
  "name": "projectionlab-mcp",
  "version": "1.0.0",
  "description": "MCP server bridging Claude Code to ProjectionLab Plugin API",
  "type": "module",
  "license": "MIT",
  "author": "Ted Lanham",
  "homepage": "https://github.com/Backroads4Me/projectionlab-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Backroads4Me/projectionlab-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Backroads4Me/projectionlab-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "projectionlab",
    "retirement",
    "fire",
    "financial-planning",
    "claude"
  ],
  "bin": {
    "projectionlab-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "HOW-IT-WORKS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "//overrides": "Patched transitive deps of the MCP SDK, kept within each parent's declared range (in-major) for compatibility. All except fast-uri live only in the SDK's HTTP/SSE transport, which this stdio-only server never loads; fast-uri is used by ajv for schema validation.",
  "overrides": {
    "fast-uri": "^3.1.6",
    "hono": "^4.13.4",
    "@hono/node-server": "^1.19.17",
    "path-to-regexp": "^8.4.2",
    "body-parser": "^2.3.0",
    "qs": "^6.15.3",
    "ip-address": "^10.5.0",
    "express-rate-limit": "^8.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
