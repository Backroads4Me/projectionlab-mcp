{
  "manifest_version": 3,
  "name": "ProjectionLab MCP Bridge",
  "version": "0.1.0",
  "description": "Connects ProjectionLab's Plugin API to a local projectionlab-mcp server.",
  "homepage_url": "https://github.com/Backroads4Me/projectionlab-mcp",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["https://app.projectionlab.com/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "ProjectionLab MCP Bridge", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
