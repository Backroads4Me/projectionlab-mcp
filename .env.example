# Development checkout only. Installed copies read ~/.projectionlab-mcp/.env
# (same format) or the MCP host's env block, which takes precedence.

# Required: Plugin API Key from ProjectionLab Account Settings > Plugins
PL_API_KEY=your-projectionlab-api-key-here

# The server listens on a localhost WebSocket for the browser extension (or
# bootstrap snippet) to connect.
# PL_WS_PORT=8788
# PL_WS_TOKEN=                # blank or unset: a token is generated and stored at ~/.projectionlab-mcp/ws-token

# Optional (defaults shown)
# PL_APP_URL=https://app.projectionlab.com
# PL_API_READY_TIMEOUT_MS=30000
# PL_EXPORT_CACHE_MS=90000
# PL_PRETTY_JSON=false        # pretty-print JSON output (uses ~25-40% more tokens)
# PL_SNAPSHOT_DIR=~/.projectionlab-mcp/snapshots
# PL_UPDATE_CHECK=true        # one registry.npmjs.org request per start, to check for a newer release
# LOG_LEVEL=info

# Writes are disabled unless this is exactly "false".
PL_READ_ONLY=true
